{
  "name": "@kamilio/tonies-homey",
  "version": "0.1.2",
  "private": true,
  "description": "Toniebox 2 playback, night mode, and realtime Flow triggers for Homey",
  "repository": { "type": "git", "url": "git+https://github.com/kamilio/tonies-homey.git" },
  "author": {
    "name": "Kamil Jopek",
    "email": "kjopek@users.noreply.github.com"
  },
  "license": "MIT",
  "main": "app.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs && homey app build",
    "validate": "node scripts/build.mjs && homey app validate --level debug",
    "test": "node --test test/*.test.js",
    "test:memory": "node --expose-gc test/app.test.js",
    "smoke:build": "node scripts/smoke.mjs",
    "verify": "npm test && npm run validate && npm run build && npm run smoke:build"
  },
  "dependencies": {
    "mqtt": "^5.15.2"
  },
  "devDependencies": {
    "@kamils-jamco/tonies-sdk": "git+https://github.com/kamilio/tonies-sdk.git#b4ffb2e60e990a6d416bb5315dcbd393c44deab0",
    "@resvg/resvg-js": "^2.6.2",
    "esbuild": "^0.28.2",
    "homey": "4.3.1"
  }
}
