{
  "id": "com.kjopek.tonies",
  "version": "0.1.0",
  "compatibility": ">=12.9.0",
  "sdk": 3,
  "runtime": "nodejs",
  "platforms": [
    "local"
  ],
  "brandColor": "#6049AD",
  "name": {
    "en": "Toniebox 2"
  },
  "description": {
    "en": "Night mode, playback controls, and listening automations for Toniebox 2."
  },
  "author": {
    "name": "Kamil Jopek",
    "email": "kjopek@users.noreply.github.com"
  },
  "category": [
    "music"
  ],
  "permissions": [],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "capabilities": {
    "night_mode": {
      "type": "boolean",
      "title": {
        "en": "Night mode"
      },
      "getable": true,
      "setable": true,
      "uiComponent": "toggle",
      "icon": "/assets/night.svg"
    },
    "toniebox_online": {
      "type": "boolean",
      "title": {
        "en": "Online"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/icon.svg"
    },
    "headphones_connected": {
      "type": "boolean",
      "title": {
        "en": "Headphones connected"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/icon.svg"
    },
    "sleep_timer_remaining": {
      "type": "number",
      "title": {
        "en": "Night mode remaining"
      },
      "getable": true,
      "setable": false,
      "units": {
        "en": "min"
      },
      "min": 0,
      "decimals": 1,
      "uiComponent": "sensor",
      "icon": "/assets/night.svg"
    },
    "tonie_id": {
      "type": "string",
      "title": {
        "en": "Tonie ID"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/icon.svg"
    },
    "chapter_number": {
      "type": "number",
      "title": {
        "en": "Chapter"
      },
      "getable": true,
      "setable": false,
      "min": 0,
      "decimals": 0,
      "uiComponent": "sensor",
      "icon": "/assets/icon.svg"
    },
    "ring_brightness": {
      "type": "number",
      "title": {
        "en": "Light ring"
      },
      "getable": true,
      "setable": true,
      "min": 0,
      "max": 100,
      "step": 1,
      "decimals": 0,
      "units": {
        "en": "%"
      },
      "uiComponent": "slider",
      "icon": "/assets/night.svg"
    }
  },
  "flow": {
    "actions": [
      {
        "id": "night_mode_on",
        "title": {
          "en": "Start night mode for … minutes"
        },
        "titleFormatted": {
          "en": "Start night mode for [[minutes]] minutes"
        },
        "hint": {
          "en": "Starts the native sleep timer with light using the box’s bedtime light and volume settings; requires an online box."
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=toniebox2"
          },
          {
            "name": "minutes",
            "type": "number",
            "title": {
              "en": "Minutes"
            },
            "min": 1,
            "max": 720,
            "step": 1
          }
        ]
      },
      {
        "id": "night_mode_off",
        "title": {
          "en": "Stop night mode"
        },
        "titleFormatted": {
          "en": "Stop night mode"
        },
        "hint": {
          "en": "Cancels the native sleep-light timer, not scheduled sunrise alarms."
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=toniebox2"
          }
        ]
      },
      {
        "id": "night_light",
        "title": {
          "en": "Set night light to … at …%"
        },
        "titleFormatted": {
          "en": "Set night light to [[color]] at [[brightness]]%"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=toniebox2"
          },
          {
            "name": "color",
            "type": "text",
            "title": {
              "en": "Hex color (#ff8800)"
            }
          },
          {
            "name": "brightness",
            "type": "number",
            "title": {
              "en": "Brightness (%)"
            },
            "min": 0,
            "max": 100,
            "step": 1
          }
        ]
      },
      {
        "id": "night_volume",
        "title": {
          "en": "Set night volume limits to …% / …%"
        },
        "titleFormatted": {
          "en": "Set night volume limits to [[speaker]]% / [[headphones]]%"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=toniebox2"
          },
          {
            "name": "speaker",
            "type": "number",
            "title": {
              "en": "Speaker limit (%)"
            },
            "min": 1,
            "max": 100,
            "step": 1
          },
          {
            "name": "headphones",
            "type": "number",
            "title": {
              "en": "Headphone limit (%)"
            },
            "min": 1,
            "max": 100,
            "step": 1
          }
        ]
      },
      {
        "id": "play",
        "title": {
          "en": "Resume playback"
        },
        "titleFormatted": {
          "en": "Resume playback"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=toniebox2"
          }
        ]
      },
      {
        "id": "pause",
        "title": {
          "en": "Pause playback"
        },
        "titleFormatted": {
          "en": "Pause playback"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=toniebox2"
          }
        ]
      },
      {
        "id": "next",
        "title": {
          "en": "Next chapter"
        },
        "titleFormatted": {
          "en": "Next chapter"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=toniebox2"
          }
        ]
      },
      {
        "id": "previous",
        "title": {
          "en": "Previous chapter"
        },
        "titleFormatted": {
          "en": "Previous chapter"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=toniebox2"
          }
        ]
      },
      {
        "id": "seek",
        "title": {
          "en": "Go to chapter …"
        },
        "titleFormatted": {
          "en": "Go to chapter [[chapter]]"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=toniebox2"
          },
          {
            "name": "chapter",
            "type": "number",
            "title": {
              "en": "Chapter (starts at 1)"
            },
            "min": 1,
            "max": 999,
            "step": 1
          }
        ]
      },
      {
        "id": "volume",
        "title": {
          "en": "Set playback volume to …%"
        },
        "titleFormatted": {
          "en": "Set playback volume to [[percent]]%"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=toniebox2"
          },
          {
            "name": "percent",
            "type": "number",
            "title": {
              "en": "Volume (%)"
            },
            "min": 0,
            "max": 100,
            "step": 1
          }
        ]
      },
      {
        "id": "volume_up",
        "title": {
          "en": "Raise playback volume one step"
        },
        "titleFormatted": {
          "en": "Raise playback volume one step"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=toniebox2"
          }
        ]
      },
      {
        "id": "volume_down",
        "title": {
          "en": "Lower playback volume one step"
        },
        "titleFormatted": {
          "en": "Lower playback volume one step"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=toniebox2"
          }
        ]
      },
      {
        "id": "volume_limit",
        "title": {
          "en": "Set speaker volume limit to …%"
        },
        "titleFormatted": {
          "en": "Set speaker volume limit to [[percent]]%"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=toniebox2"
          },
          {
            "name": "percent",
            "type": "dropdown",
            "title": {
              "en": "Maximum volume"
            },
            "values": [
              {
                "id": "25",
                "label": {
                  "en": "25%"
                }
              },
              {
                "id": "50",
                "label": {
                  "en": "50%"
                }
              },
              {
                "id": "75",
                "label": {
                  "en": "75%"
                }
              },
              {
                "id": "100",
                "label": {
                  "en": "100%"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "ring_brightness",
        "title": {
          "en": "Set light ring brightness to …%"
        },
        "titleFormatted": {
          "en": "Set light ring brightness to [[brightness]]%"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=toniebox2"
          },
          {
            "name": "brightness",
            "type": "number",
            "title": {
              "en": "Brightness (%)"
            },
            "min": 0,
            "max": 100,
            "step": 1
          }
        ]
      },
      {
        "id": "sleep_now",
        "title": {
          "en": "Put the Toniebox to sleep"
        },
        "titleFormatted": {
          "en": "Put the Toniebox to sleep"
        },
        "hint": {
          "en": "The Toniebox cannot be woken remotely; squeeze an ear to wake it."
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=toniebox2"
          }
        ]
      },
