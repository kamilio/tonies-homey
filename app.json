  "drivers": [
    {
      "id": "toniebox2",
      "name": {
        "en": "Toniebox 2"
      },
      "class": "speaker",
      "platforms": [
        "local"
      ],
      "connectivity": [
        "cloud"
      ],
      "capabilities": [
        "night_mode",
        "speaker_playing",
        "speaker_next",
        "speaker_prev",
        "volume_set",
        "volume_up",
        "volume_down",
        "measure_battery",
        "alarm_battery",
        "toniebox_online",
        "sleep_timer_remaining",
        "speaker_track",
        "tonie_id",
        "chapter_number",
        "headphones_connected",
        "ring_brightness"
      ],
      "images": {
        "small": "/assets/images/small.png",
        "large": "/assets/images/large.png",
        "xlarge": "/assets/images/xlarge.png"
      },
      "icon": "/assets/icon.svg",
      "pair": [
        {
          "id": "login_credentials",
          "template": "login_credentials"
        },
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "prev": "login_credentials",
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "repair": [
        {
          "id": "login_credentials",
          "template": "login_credentials"
        }
      ],
      "settings": [
        {
          "id": "night_minutes",
          "type": "number",
          "label": {
            "en": "Default night mode duration (minutes)"
          },
          "value": 30,
          "min": 1,
          "max": 720
        },
        {
          "id": "firmware",
          "type": "label",
          "label": {
            "en": "Firmware"
          },
          "value": "Unknown"
        },
        {
          "id": "box_id",
          "type": "label",
          "label": {
